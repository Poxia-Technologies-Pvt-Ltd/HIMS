# Copy this file to .env and fill in real values. Never commit the real .env.

# ── Server ────────────────────────────────────────────────────────────────
PORT=7005
# MUST be exactly "production" on the live server. Several security controls
# key off it and all of them fail OPEN if it is unset: the auth cookie's
# Secure/SameSite=None flags (authController.js), error-stack suppression
# (server.js), and the login brute-force limiter (middleware/rateLimiter.js).
# The Dockerfile sets it; a bare `node server.js` does not.
NODE_ENV=development
# Comma-separated list of hostnames the server will accept a Host header from
# (VAPT #11). Defaults to the hosts derived from ALLOWED_ORIGINS below, plus
# localhost/127.0.0.1 outside production.
# Production: ALLOWED_HOSTS=jh-lims.poxiatechnologies.com

# ── Database ──────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=karnataka_hmis
DB_PORT=8889

# ── Frontend / CORS ───────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API with credentials.
# Must be https:// in production — the auth cookie is Secure + SameSite=None,
# so a plaintext origin cannot hold a session at all.
# Production: ALLOWED_ORIGINS=https://jh-lims.poxiatechnologies.com
ALLOWED_ORIGINS=http://localhost:5714
# Public URL of the frontend, used to build links in emails etc.
FRONTEND_URL=http://localhost:5714
# Public URL of THIS API, used to build self-referencing links (e.g. the
# report_url sent in WhatsApp notifications). Only needed if it differs from
# a same-host inference.
# PUBLIC_API_URL=http://localhost:7005

# ── Auth ──────────────────────────────────────────────────────────────────
# Long random string — signs/verifies the staff session JWT (hims_token
# cookie). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Only needed if the API's cookie must be shared across subdomains (leave
# unset for a single-host deployment).
# COOKIE_DOMAIN=

# Developer portal (separate superuser login, controllers/developerController.js)
# DEVELOPER_EMAIL=
# DEVELOPER_JWT_SECRET=

# ── Email (password reset) ───────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_NAME=Meril HIMS

# ── WhatsApp (services/whatsappService.js — see WhatsApp-chat-bot/) ──────
WHATSAPP_BOT_URL=http://localhost:3005

# ── CARE integration (Ramgarh branches only) ─────────────────────────────
# CARE_API_KEY=
# CARE_BACKEND_URL=
# CARE_GATEWAY_KEY_ID=
# CARE_GATEWAY_PRIVATE_KEY_PEM=
# CARE_JWKS_CACHE_TTL_MS=
# CARE_REQUEST_TIMEOUT_MS=

# ── CDAC e-Sushrut HMIS integration (services/cdacService.js) ───────────
# All 7 values below MUST come from whoever manages the CDAC relationship —
# they cannot be generated locally. Every CDAC call fails immediately with
# "CDAC_BASE_URL is not configured" until this section is filled in.
#
# Base host of CDAC's e-Sushrut HMIS API (no trailing slash). The correct
# value per environment (staging vs production) is documented in
# Meril_CDAC_LIS_Integration_API_Docs.md — confirm with CDAC before deploying.
# CDAC_BASE_URL=https://<cdac-host>

# Bearer token for the Authorization header. CDAC has not documented a
# refresh flow for this token as of this integration — getCdacToken() in
# cdacService.js is a single swappable seam if/when that's clarified.
# CDAC_BEARER_TOKEN=

# Value for the HMIS-EXT-USER header CDAC requires on every call.
# CDAC_HMIS_EXT_USER=

# Value for the API-ACCESS-KEY header. Use ONE of:
#   - CDAC_API_ACCESS_KEY        a single shared key for all operations, or
#   - CDAC_API_ACCESS_KEY_MAP    a JSON object keyed by hmis_request_type
#                                 (the numeric operation code — "1","2","3",
#                                 "4","5","7","31") if CDAC issues different
#                                 keys per API, e.g.:
#                                 {"1":"key-for-api1","5":"key-for-api5"}
# A branch can also override this via branch_hmis_config.api_access_key_override
# (set in the CDAC Mapping settings page) — that takes priority over both.
# CDAC_API_ACCESS_KEY=
# CDAC_API_ACCESS_KEY_MAP=

# Request timeouts in milliseconds. The report-fetch/push calls (API5) carry
# a larger PDF payload and get their own, longer timeout.
CDAC_REQUEST_TIMEOUT_MS=15000
CDAC_REPORT_REQUEST_TIMEOUT_MS=60000

# Retry policy for transient failures (connection errors, timeouts, 5xx
# responses) — NOT applied to 4xx responses or to a 200-with-error-in-body
# response, since retrying either would just fail the same way again.
# Total attempts = CDAC_MAX_RETRIES + 1. Backoff doubles each attempt
# (CDAC_RETRY_BASE_MS, 2x, 4x, ...).
CDAC_MAX_RETRIES=2
CDAC_RETRY_BASE_MS=500

# Beyond these env vars, each branch that integrates with CDAC also needs its
# hmis_hosp_mapping_code set via the CDAC Mapping settings page (branch_hmis_config
# table) — /api/cdac/pull-order and /api/cdac/sync-master-data both reject
# with 400 until that's filled in, even with everything above configured.

# WhatsApp report delivery. 'cloud' = official WhatsApp Business Platform
# (Cloud API, Government-approved channel, delivery status via webhook at
# /api/whatsapp/webhook); 'bot' = legacy whatsapp-web.js bot (WHATSAPP_BOT_URL).
WHATSAPP_PROVIDER=bot
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template whose header is a DOCUMENT, so reports can be sent outside
# the 24-hour customer-service window.
WHATSAPP_REPORT_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Passwords older than this many days must be changed at the next login.
PASSWORD_MAX_AGE_DAYS=90

# Razorpay — online payment for paid investigations (free-scheme / NFDS orders
# never reach the gateway). Test keys start rzp_test_, live keys rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret set in Razorpay Dashboard → Webhooks for
# https://<host>/api/payments/razorpay/webhook (events: payment.captured,
# payment.failed, order.paid, payment_link.paid, payment_link.expired,
# payment_link.cancelled). Without it payments still settle through the
# browser callback and the 15-minute reconciliation job.
RAZORPAY_WEBHOOK_SECRET=

# Digital Signature Certificate for authorised report PDFs (tender #36). Leave empty to
# keep login-based e-authentication only. A PKCS#12 (.p12/.pfx) with the certificate and
# private key; REPORT_DSC_P12_BASE64 may be used instead of a file path.
REPORT_DSC_P12_PATH=
REPORT_DSC_P12_BASE64=
REPORT_DSC_P12_PASSWORD=

# Encrypts the certificate passwords a hospital admin chooses to remember ("sign automatically").
# Use a long random value and keep it out of the database backups; changing it later means
# the certificates must be uploaded again. Falls back to JWT_SECRET when empty.
DSC_VAULT_KEY=

# Sign-in: captcha on the sign-in forms. Keep true in production.
LOGIN_CAPTCHA=true
# Temporary no-password access from the start page (testing/setup only). Keep false in production.
QUICK_ACCESS=false
