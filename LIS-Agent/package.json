{
  "name": "karnataka-lims",
  "version": "2.2.1",
  "description": "Karnataka LIMS",
  "main": "main/main.js",
  "type": "commonjs",
  "scripts": {
    "_comment": "Production copy: unlike a plain dev checkout, dev does NOT override LIS_API_BASE_URL, so the main process uses the ka-lims default in main/apiBase.js. There is deliberately no renderer/.env here either \u2014 that file is what silently pinned local builds to localhost:7005.",
    "dev": "concurrently \"vite --config renderer/vite.config.js\" \"wait-on http://localhost:5173 && electron .\"",
    "start": "electron .",
    "build:ui": "vite build --config renderer/vite.config.js",
    "dist:win": "npm run build:ui && electron-builder --win",
    "dist:mac": "npm run build:ui && electron-builder --mac"
  },
  "build": {
    "appId": "com.poxiatechnologies.karnatakalims",
    "productName": "Karnataka LIMS",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "generic",
      "url": "https://ka-lims.poxiatechnologies.com/download/"
    },
    "icon": "build/icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png"
    },
    "files": [
      "main/**/*",
      "dist/**/*",
      "db/**/*",
      "build/**/*",
      "package.json",
      "renderer/src/assets/img/meril.png"
    ],
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "dependencies": {
    "axios": "^1.16.0",
    "dompurify": "^3.4.12",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^6.30.4",
    "react-router-dom": "^6.30.4",
    "serialport": "^13.0.0",
    "sqlite3": "^6.0.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "vite": "^8.0.10",
    "wait-on": "^9.0.10"
  }
}